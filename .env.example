FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=goose-tecnologia-noc-secret-key-2026
# String de conexão principal com o MySQL
DATABASE_URL=mysql+pymysql://root:@localhost:3306/blog_gtecnologia?charset=utf8mb4
# Caso o servidor MySQL não esteja ativo no ambiente local de desenvolvimento, permite fallback automático para SQLite
ALLOW_SQLITE_FALLBACK=true

